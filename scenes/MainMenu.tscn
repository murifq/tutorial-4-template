[connection signal="pressed" from="HBoxContainer/VBoxContainer/NewGameButton" to="HBoxContainer/VBoxContainer/NewGameButton" method="_on_pressed" binds= ["Level1"]]
[connection signal="pressed" from="HBoxContainer/VBoxContainer/Level2Button" to="HBoxContainer/VBoxContainer/Level2Button" method="_on_pressed" binds= ["SelectLevelMenu"]]
